<%# locals: (calendar:, **args) %>
<% shade = ->(level) { level.zero? ? nil : "color-mix(in oklab, var(--color-orange-500) #{[ 22, 45, 72, 100 ][level - 1]}%, transparent)" } %>
<%# No Turbo prefetch: sweeping the pointer across the calendar would fetch a page per day. %>
<div id="spending-calendar" class="relative px-4 pb-4"
     data-turbo-prefetch="false"
     data-controller="spending-calendar"
     data-action="mouseleave->spending-calendar#hide">
  <% if calendar.any? %>
    <div class="flex flex-col lg:flex-row gap-6">
      <div class="flex-1 min-w-0 space-y-2">
        <div class="flex gap-2">
          <%# Weekday labels: Mon, Wed, Fri, as a calendar does, to keep the column light. %>
          <div class="grid grid-rows-7 gap-[3px] pt-5 text-[10px] leading-none text-secondary shrink-0" aria-hidden="true">
            <% calendar.weekday_labels.each_with_index do |label, i| %>
              <span class="flex items-center h-full"><%= i.even? ? label : "" %></span>
            <% end %>
          </div>

          <div class="flex-1 min-w-0">
            <div class="relative h-4 mb-1 text-[10px] leading-4 text-secondary" aria-hidden="true">
              <% calendar.month_labels.each do |column, label| %>
                <span class="absolute" style="left: <%= (column.to_f / calendar.weeks.size * 100).round(2) %>%"><%= label %></span>
              <% end %>
            </div>
            <div class="grid gap-[3px]" style="grid-template-columns: repeat(<%= calendar.weeks.size %>, minmax(0, 1fr)); grid-template-rows: repeat(7, auto); grid-auto-flow: column;"
                 role="group" aria-label="<%= t(".aria_label") %>">
              <% calendar.days.each do |day| %>
                <% if day.in_range %>
                  <% label = t(".cell_label", date: l(day.date, format: :long), amount: format_money(day.total, precision: 0)) %>
                  <%= link_to transactions_path(q: { start_date: day.date, end_date: day.date }),
                        class: "block aspect-square rounded-[3px] outline-none focus-visible:ring-2 focus-visible:ring-gray-900 hover:ring-1 hover:ring-gray-400 #{"bg-surface-inset" if day.level.zero?}",
                        style: ("background-color: #{shade.(day.level)}" if day.level.positive?),
                        aria: { label: label },
                        data: {
                          action: "mouseenter->spending-calendar#show focus->spending-calendar#show blur->spending-calendar#hide",
                          date: l(day.date, format: "%a, %d %b %Y"),
                          total: format_money(day.total, precision: 0),
                          items: day.items.map { |item| [ item.name, format_money(item.amount, precision: 0) ] }.to_json
                        } do %>
                    <span class="sr-only"><%= label %></span>
                  <% end %>
                <% else %>
                  <span class="block aspect-square" aria-hidden="true"></span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end gap-1 text-[10px] text-secondary" aria-hidden="true">
          <span class="mr-1"><%= t(".less") %></span>
          <span class="w-2.5 h-2.5 rounded-[2px] bg-surface-inset"></span>
          <% (1..Dashboard::SpendingCalendar::LEVELS).each do |level| %>
            <span class="w-2.5 h-2.5 rounded-[2px]" style="background-color: <%= shade.(level) %>"></span>
          <% end %>
          <span class="ml-1"><%= t(".more") %></span>
        </div>
      </div>

      <div class="lg:w-72 shrink-0 space-y-4 text-sm">
        <div class="grid grid-cols-3 lg:grid-cols-1 gap-3">
          <div>
            <p class="text-xs text-secondary"><%= t(".usual_day") %></p>
            <p class="font-medium privacy-sensitive"><%= format_money(calendar.average_day, precision: 0) %></p>
          </div>
          <div>
            <p class="text-xs text-secondary"><%= t(".no_spend_days") %></p>
            <p class="font-medium"><%= t(".no_spend_count", count: calendar.no_spend_days, total: calendar.tracked_days.size) %></p>
          </div>
          <% weekend, weekday = calendar.weekend_vs_weekday %>
          <div>
            <p class="text-xs text-secondary"><%= t(".weekend_vs_weekday") %></p>
            <p class="font-medium privacy-sensitive"><%= format_money(weekend, precision: 0) %> <span class="text-secondary font-normal">/</span> <%= format_money(weekday, precision: 0) %></p>
          </div>
        </div>

        <div class="space-y-1.5">
          <p class="text-xs text-secondary"><%= t(".by_weekday") %></p>
          <% calendar.weekdays.each do |w| %>
            <div class="flex items-center gap-2 text-xs">
              <span class="w-8 text-secondary"><%= w.label %></span>
              <div class="flex-1 h-1.5 rounded-full bg-surface-inset overflow-hidden">
                <div class="h-full rounded-full" style="width: <%= w.share %>%; background-color: var(--color-orange-500)"></div>
              </div>
              <span class="w-16 text-right privacy-sensitive"><%= format_money(w.average, precision: 0) %></span>
            </div>
          <% end %>
        </div>

        <div class="space-y-1.5">
          <p class="text-xs text-secondary"><%= t(".biggest_days") %></p>
          <% calendar.biggest_days.each do |day| %>
            <%= link_to transactions_path(q: { start_date: day.date, end_date: day.date }), class: "flex items-start justify-between gap-2 rounded-md -mx-1 px-1 py-0.5 hover:bg-container-inset" do %>
              <span class="min-w-0">
                <span class="block text-xs"><%= l(day.date, format: "%a, %d %b") %></span>
                <span class="block text-xs text-secondary truncate"><%= day.items.first&.name %></span>
              </span>
              <span class="text-xs font-medium privacy-sensitive whitespace-nowrap"><%= format_money(day.total, precision: 0) %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <%# One floating card, filled from the hovered day's data attributes. %>
    <div data-spending-calendar-target="tooltip" role="tooltip"
         class="pointer-events-none absolute left-0 top-0 z-50 hidden w-60 rounded-lg bg-container shadow-border-xs border border-primary p-3 text-xs space-y-1.5">
      <div class="flex items-baseline justify-between gap-2">
        <span class="font-medium text-primary" data-spending-calendar-target="date"></span>
        <span class="font-medium text-primary privacy-sensitive" data-spending-calendar-target="total"></span>
      </div>
      <ul class="space-y-1 text-secondary" data-spending-calendar-target="items"></ul>
      <p class="hidden text-secondary" data-spending-calendar-target="empty"><%= t(".no_spending") %></p>
    </div>
  <% else %>
    <p class="text-sm text-secondary py-6 text-center"><%= t(".empty") %></p>
  <% end %>
</div>
