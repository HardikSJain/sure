<%= turbo_frame_tag "projection", data: { turbo_action: "advance" } do %>
  <div class="space-y-4 pb-6 lg:pb-12">
    <header>
      <h1 class="text-2xl font-semibold text-primary"><%= t(".title") %></h1>
      <p class="text-sm text-secondary mt-1"><%= t(".subtitle") %></p>
    </header>

    <% if @projection.ready? %>
      <section class="bg-container rounded-xl shadow-border-xs p-4 lg:p-6 space-y-6">
        <%= render "projections/headline", projection: @projection, year: @year %>
        <%= render "projections/chart", projection: @projection, year: @year %>
        <%= render "projections/answers", projection: @projection, year: @year %>
        <%= render "projections/take_home", projection: @projection %>
      </section>
    <% else %>
      <div class="bg-container rounded-xl shadow-border-xs p-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <% if @projection.missing == :spending %>
          <p class="text-sm text-primary"><%= t(".needs_spending") %></p>
        <% else %>
          <p class="text-sm text-primary"><%= t(@projection.india? ? ".not_ready" : ".not_ready_no_ctc") %></p>
          <%= link_to t(".not_ready_link"), bills_path, class: "text-xs text-secondary hover:text-primary", data: { turbo_frame: "_top" } %>
        <% end %>
      </div>
    <% end %>

    <%= render "projections/assumptions", projection: @projection, year: @year %>

    <p class="text-xs text-secondary"><%= t(".estimates") %></p>
  </div>
<% end %>
