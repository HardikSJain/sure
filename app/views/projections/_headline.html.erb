<%# locals: (projection:, year:) %>
<%
  goal = projection.goal
  share = projection.goal_share
  crossing = projection.crossing
  strong = projection.crossing(:strong)
  weak = projection.crossing(:weak)
  month = ->(date) { l(date, format: "%b %Y") }
  age = ->(date) { (a = projection.age_at(date)) ? t(".at_age", age: a) : nil }
  ring = 2 * Math::PI * 24
%>
<div class="space-y-5">
  <% if goal %>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm text-secondary privacy-sensitive"><%= t(".reach_label", goal: compact_money(goal)) %></p>
        <% if crossing %>
          <p class="text-4xl font-semibold tracking-tight text-primary">
            <%= month.(crossing) %><% if (a = age.(crossing)) %><span class="text-xl font-medium text-secondary ml-2"><%= a %></span><% end %>
          </p>
          <p class="text-sm text-secondary mt-1">
            <%= t(".reach_range", strong: strong ? month.(strong) : t(".beyond"), weak: weak ? month.(weak) : t(".beyond")) %>
          </p>
        <% else %>
          <p class="text-3xl font-semibold tracking-tight text-primary"><%= t(".not_within", years: Projection::SEARCH_YEARS) %></p>
          <p class="text-sm text-secondary mt-1"><%= t(".not_within_hint") %></p>
        <% end %>
      </div>

      <div data-projection-goal class="flex items-center gap-3 rounded-xl bg-container-inset px-4 py-3">
        <svg width="58" height="58" viewBox="0 0 58 58" role="img" aria-label="<%= t(".ring_aria", share: share) %>">
          <circle cx="29" cy="29" r="24" fill="none" stroke="var(--color-yellow-500)" stroke-opacity=".2" stroke-width="6" />
          <circle cx="29" cy="29" r="24" fill="none" stroke="var(--color-yellow-500)" stroke-width="6" stroke-linecap="round"
                  stroke-dasharray="<%= (ring * share / 100.0).round(1) %> <%= ring.round(1) %>" transform="rotate(-90 29 29)" />
          <text x="29" y="33" text-anchor="middle" font-size="12" font-weight="600" fill="currentColor"><%= share %>%</text>
        </svg>
        <div class="text-sm leading-snug">
          <p class="font-medium text-primary privacy-sensitive"><%= t(".of_goal", goal: compact_money(goal)) %></p>
          <p class="text-secondary privacy-sensitive"><%= t(".today", amount: compact_money(projection.today_total)) %></p>
        </div>
      </div>
    </div>
  <% end %>

  <div class="flex flex-wrap items-center justify-between gap-3 <%= "pt-4 border-t border-primary" if goal %>">
    <div>
      <p class="text-sm text-secondary"><%= t(".label", month: month.(Date.new(year, 12, 1)), age: (a = age.(Date.new(year, 12, 31))) ? ", #{a}" : "") %></p>
      <p class="<%= goal ? "text-2xl" : "text-4xl" %> font-semibold tracking-tight text-primary privacy-sensitive"><%= compact_money(projection.value_at(year)) %></p>
      <p class="text-sm text-secondary mt-0.5 privacy-sensitive">
        <%= t(".range", low: compact_money(projection.value_at(year, :weak)), high: compact_money(projection.value_at(year, :strong))) %>
      </p>
    </div>
    <nav class="flex flex-wrap rounded-lg bg-container-inset p-0.5 text-xs" aria-label="<%= t(".years") %>">
      <% projection.years.each do |y| %>
        <%= link_to projection_path(year: y),
              class: class_names("px-2.5 py-1 rounded-md", y == year ? "bg-container text-primary shadow-border-xs font-medium" : "text-secondary hover:text-primary"),
              aria: { current: (y == year ? "true" : nil) } do %>
          <%= y %><% if (a = projection.age_at(Date.new(y, 12, 31))) %><span class="text-secondary"> · <%= a %></span><% end %>
        <% end %>
      <% end %>
    </nav>
  </div>
</div>
