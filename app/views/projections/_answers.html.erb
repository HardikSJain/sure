<%# locals: (projection:, year:) %>
<%
  month = ->(date) { l(date, format: "%b %Y") }
  ways = projection.ways_sooner
  epf = projection.epf_aside(year)
  value = projection.value_at(year)
  parts = projection.composition(year)
  segments = [
    [ t(".today"), parts[:today], "var(--color-gray-500)" ],
    [ t(".put_in"), parts[:put_in], "var(--color-blue-500)" ],
    [ parts[:growth].negative? ? t(".loss") : t(".growth"), parts[:growth], "var(--color-green-500)" ]
  ]
  positive_total = segments.sum { |_, m, _| [ m.amount, 0 ].max }
%>
<% if ways.any? %>
  <div class="space-y-2" data-projection-sooner>
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h3 class="text-sm font-medium text-primary"><%= t(".sooner_title") %></h3>
      <p class="text-xs text-secondary"><%= t(".sooner_hint") %></p>
    </div>
    <ul class="divide-y divide-primary rounded-xl bg-container-inset">
      <% ways.each do |way| %>
        <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 px-3.5 py-2.5 text-sm">
          <span class="text-primary privacy-sensitive">
            <%= way.kind == :category ? t(".less_on", amount: format_money(way.amount, precision: 0), category: way.name) : t(".less_overall", amount: format_money(way.amount, precision: 0)) %>
          </span>
          <span class="text-right">
            <% if way.crossing %>
              <span class="font-medium text-primary"><%= month.(way.crossing) %><% if (a = projection.age_at(way.crossing)) %>, <%= t(".at_age", age: a) %><% end %></span>
              <span class="text-xs <%= way.months_sooner.to_i.positive? ? "text-success" : "text-secondary" %>">
                <%= way.months_sooner.nil? ? t(".within_reach") : way.months_sooner.positive? ? t(".months_sooner", count: way.months_sooner) : t(".no_change") %>
              </span>
            <% else %>
              <span class="text-xs text-secondary"><%= t(".still_beyond", years: Projection::SEARCH_YEARS) %></span>
            <% end %>
          </span>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if epf %>
  <p class="text-xs text-secondary privacy-sensitive">
    <span class="font-medium text-primary"><%= t(".epf_label") %></span>
    <%= projection.buckets.any? { |b| b.key == "epf" } ? t(".epf_left_out", amount: compact_money(epf)) : t(".epf_no_account", amount: compact_money(epf), month: month.(Date.new(year, 12, 1))) %>
  </p>
<% end %>

<div class="space-y-2">
  <p class="text-xs text-secondary privacy-sensitive"><%= t(".made_of", amount: compact_money(value), month: month.(Date.new(year, 12, 1))) %></p>
  <% if positive_total.positive? %>
    <div class="flex h-2.5 w-full gap-0.5 overflow-hidden rounded-full" role="img"
         aria-label="<%= segments.map { |label, m, _| "#{label} #{compact_money(m)}" }.join(", ") %>">
      <% segments.each do |_, m, color| %>
        <% next unless m.amount.positive? %>
        <div class="h-full" style="width: <%= (m.amount / positive_total * 100).round(1) %>%; background-color: <%= color %>"></div>
      <% end %>
    </div>
  <% end %>
  <div class="flex flex-wrap gap-x-5 gap-y-1 text-xs text-secondary">
    <% segments.each do |label, m, color| %>
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full" style="background-color: <%= color %>"></span>
        <%= label %> <span class="font-medium text-primary privacy-sensitive"><%= compact_money(m) %></span>
      </span>
    <% end %>
  </div>
</div>
